<?php    
use Drupal\Core\Routing\RouteMatchInterface;
\Drupal::moduleHandler()->loadInclude('website_toolbox_forum', 'api.inc');  
function website_toolbox_forum_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.website_toolbox_forum':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Your Drupal forum doesn’t need to be basic. Website Toolbox is a cloud-based forum plugin that allows you to easily add a powerful, intuitive, and maintenance-free forum to Drupal without slowing it down. No database, servers, or coding required');
      $output .= '<h3>' . t('How to Configure Website Toolbox Forum') . '</h3>';
      $output .= '<dl>';
      $output .= '<dt>' . t('Go to Modules >> Website Toolbox Forum >> Configure.') . '</dt>';
      $output .= '<dt>' . t('Enter your Website Toolbox account information') . '</dt>';
      $output .= '<dt>' . t('Select option to embedded/non-embedded forum') . '</dt>';
      $output .= '<dd></dd>';
      $output .= '<dd>' . t('<b>Embedded: </b> Forum will be displayed on a website page as a "forum".') . '</dd>';
      $output .= '<dd>' . t('<b>Non-embedded: </b>Will create a menu link but will take you to the forum page(https://yourforum.discussion.community)') . '</dd>';
     
      $output .= '</dl>';
      return $output;
      }
}
function website_toolbox_forum_node_view($build) { 
	$forumsApiKey = \Drupal::config('node.settings')->get('forum_api_key');
	$forumUrl     = \Drupal::config('node.settings')->get('forum_url');
  $content      =  $build['body'][0]['#text'];
	if (preg_match('#^https?://#', \Drupal::config('node.settings')->get('forum_url'))) {
	    $forumUrl = \Drupal::config('node.settings')->get('forum_url');
	} else {
	    $forumUrl = "http://" . \Drupal::config('node.settings')->get('forum_url');
	}
	$forumEmbedUrl = preg_replace('#^https?:#i', '', $forumUrl);
	$auth_token    = '';
	if (isset($_COOKIE['forumLogoutToken'])) {
	    $auth_token = "?authtoken=" . $_COOKIE['forumLogoutToken'];
	} elseif (isset($_SESSION['forumLoginAuthToken'])) {
	    $auth_token = "?authtoken=" . $_SESSION['forumLoginAuthToken'];
	}
	if (isset($_COOKIE['forumLogoutToken']) && isset($_COOKIE['loginRemember'])) {
	    $auth_token .= "&remember=" . $_COOKIE['loginRemember'];
	}
	$embedURL                   = $forumEmbedUrl . '/js/mb/embed.js';
	$newURL                     = $forumEmbedUrl . '/js/mb/embed.js' . $auth_token;
	$content_changed            = str_replace($embedURL, $newURL, $content);
	$build['body'][0]['#text']  = $content_changed;
}
//alter forum link if not embedded before page render//
 $checkIfEmbedded = \Drupal::config('node.settings')->get('forum_embedded_option'); 
 if($checkIfEmbedded != 1 && isset($_COOKIE['forumLogoutToken'])){  
   function  website_toolbox_forum_link_alter(&$variables){   
      if($variables['text'] == 'Forum'){  
         if (isset($_COOKIE['forumLogoutToken'])) { 
                $cookie = $_COOKIE['forumLogoutToken'];
            } elseif (isset($_SESSION['forumLoginAuthToken'])) {
                $cookie = $_SESSION['forumLoginAuthToken'];
            }
         $variables['options']['query']['authtoken']  = $cookie ;
      }
    }
}
function website_toolbox_forum_user_login($account){
  $userId = \Drupal::currentUser()->id();
  $email = \Drupal::currentUser()->getEmail();
  $username = \Drupal::currentUser()->getAccountName();
  $userData = (object) array(
      'name' => $username,
      'mail' => $email,
      'externalUserid' => $userId
  );   
  $getAuthDetails = Drupal\website_toolbox_forum\website_toolbox_forum_get_forum_authtoken($userData, "login");
  Drupal\website_toolbox_forum\website_toolbox_forum_set_cookie_on_login($getAuthDetails, "");
  Drupal\website_toolbox_forum\website_toolbox_forum_save_authtoken($getAuthDetails['authtoken'], $getAuthDetails['forumUserid']);
  drupal_static_reset();
  drupal_flush_all_caches();
}
