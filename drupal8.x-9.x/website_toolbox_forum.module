<?php    
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Entity\EntityInterface;
\Drupal::moduleHandler()->loadInclude('website_toolbox_forum', 'api.inc');  
function website_toolbox_forum_help($route_name, RouteMatchInterface $route_match) {
    switch ($route_name) {
      case 'help.page.website_toolbox_forum':
        $output = '';
        $output .= '<h3>' . t('About') . '</h3>';
        $output .= '<p>' . t('Your Drupal forum doesn’t need to be basic. Website Toolbox is a cloud-based forum plugin that allows you to easily add a powerful, intuitive, and maintenance-free forum to Drupal without slowing it down. No database, servers, or coding required');
        $output .= '<h3>' . t('How to Configure Website Toolbox Forum') . '</h3>';
        $output .= '<dl>';
        $output .= '<dt>' . t('Go to Modules >> Website Toolbox Forum >> Configure.') . '</dt>';
        $output .= '<dt>' . t('Enter your Website Toolbox account information') . '</dt>';
        $output .= '<dt>' . t('Select option to embedded/non-embedded forum') . '</dt>';
        $output .= '<dd></dd>';
        $output .= '<dd>' . t('<b>Embedded: </b> Forum will be displayed on a website page as a "forum".') . '</dd>';
        $output .= '<dd>' . t('<b>Non-embedded: </b>Will create a menu link but will take you to the forum page(https://yourforum.discussion.community)') . '</dd>';     
        $output .= '</dl>';
        return $output;
        }
}
 if($forumsEmeddedOption == 1){
    function website_toolbox_forum_node_view($build) { 
      	$forumsApiKey = \Drupal::config('node.settings')->get('forum_api_key');
      	$forumUrl     = \Drupal::config('node.settings')->get('forum_url');
        $content      =  $build['body'][0]['#text'];
        if($content){
          	if (preg_match('#^https?://#', \Drupal::config('node.settings')->get('forum_url'))) {
          	    $forumUrl = \Drupal::config('node.settings')->get('forum_url');
          	} else {
          	    $forumUrl = "http://" . \Drupal::config('node.settings')->get('forum_url');
          	}
          	$forumEmbedUrl = preg_replace('#^https?:#i', '', $forumUrl);
          	$auth_token    = '';
          	if (isset($_COOKIE['forumLogoutToken'])) {
          	    $auth_token = "?authtoken=" . $_COOKIE['forumLogoutToken'];
          	} elseif (isset($_SESSION['forumLoginAuthToken'])) {
          	    $auth_token = "?authtoken=" . $_SESSION['forumLoginAuthToken'];
          	}
          	if (isset($_COOKIE['forumLogoutToken']) && isset($_COOKIE['loginRemember'])) {
          	    $auth_token .= "&remember=" . $_COOKIE['loginRemember'];
          	}
          	$embedURL                   = $forumEmbedUrl . '/js/mb/embed.js';
          	$newURL                     = $forumEmbedUrl . '/js/mb/embed.js' . $auth_token;
          	$content_changed            = str_replace($embedURL, $newURL, $content);
          	$build['body'][0]['#text']  = $content_changed;
        }
      }
      //alter forum link if not embedded before page render//
       $checkIfEmbedded = \Drupal::config('node.settings')->get('forum_embedded_option'); 
       if($checkIfEmbedded != 1 && isset($_COOKIE['forumLogoutToken'])){  
         function  website_toolbox_forum_link_alter(&$variables){   
            if($variables['text'] == 'Forum'){  
               if (isset($_COOKIE['forumLogoutToken'])) { 
                      $cookie = $_COOKIE['forumLogoutToken'];
                  } elseif (isset($_SESSION['forumLoginAuthToken'])) {
                      $cookie = $_SESSION['forumLoginAuthToken'];
                  }
               $variables['options']['query']['authtoken']  = $cookie ;
            }
          }
    }
}
function website_toolbox_forum_user_login($account){
    $userId = \Drupal::currentUser()->id();
    $email = \Drupal::currentUser()->getEmail();
    $username = \Drupal::currentUser()->getAccountName();
    $userData = (object) array(
        'name' => $username,
        'mail' => $email,
        'externalUserid' => $userId
    );   
    $getAuthDetails = Drupal\website_toolbox_forum\getForumAuthtoken($userData, "login");
    Drupal\website_toolbox_forum\setCookieOnLogin($getAuthDetails, "");
    Drupal\website_toolbox_forum\saveAuthToken($getAuthDetails['authtoken'], $getAuthDetails['forumUserid']);
    drupal_static_reset();
    drupal_flush_all_caches();
}

function website_toolbox_forum_user_insert(Drupal\Core\Entity\EntityInterface $entity){
    $roles = $entity->getRoles(TRUE);
    $userGroupId = Drupal\website_toolbox_forum\getCustomUserGroups();
    $customUserGroups = array_keys(array_intersect($userGroupId,$roles)); 
    $username = $_POST['name'];
    $email    = $_POST['mail'];
    $pass     = $_POST['pass'];
    $userId   = $entity->id();
    $userData = (object) array(
        'name' => $username,
        'mail' => $email,
        'pass' => $pass,
        'externalUserid' => $userId
    );        
    $user = \Drupal\user\Entity\User::load($entity->id());
    if(!$user->user_picture->isEmpty()){
      $avatarUrl = file_create_url($user->user_picture->entity->getFileUri());
    }else{
      $avatarUrl = '';
    }
    $forumsApiKey = \Drupal::config('node.settings')->get('forum_api_key') ;
    $forumUrl     = \Drupal::config('node.settings')->get('forum_url'); 
    $URL          = $forumUrl . "/register/create_account/";
    $request = \Drupal::httpClient()->post($URL, ['verify' => true,'form_params' => ['apikey' => $forumsApiKey,'member' => $username,'email' => $email,'externalUserid' => $userId,"avatarUrl" => $avatarUrl]])->getBody()->getContents(); 
    if (!$request) {
        drupal_set_message($result->error);
        die();
    }else{
      $syncOption = \Drupal::config('node.settings')->get('forum_roles_sync_option');
      if($syncOption == 1){
        Drupal\website_toolbox_forum\assignDivestUserGroup($email, $username, $customUserGroups);
      }
    }
    drupal_static_reset();
    drupal_flush_all_caches();      
}
function website_toolbox_forum_user_presave( Drupal\Core\Entity\EntityInterface $entity){
    if($entity->original){
        $user = \Drupal\user\Entity\User::load($entity->id());
        $_SESSION['oldUserEmail'] = $user->getEmail();
    }
}
function website_toolbox_forum_user_update(Drupal\Core\Entity\EntityInterface $entity){   
    $emailToVerify  = $_SESSION['oldUserEmail'];
    $getUserDetails     = Drupal\website_toolbox_forum\getUserDetails($emailToVerify);
    $userGroupId = $getUserDetails->{'data'}[0]->{'userGroups'};
    if ($getUserDetails->{'data'}[0]->{'userId'}) {
        $userId = $getUserDetails->{'data'}[0]->{'userId'};
    }
    $userName = $entity->getAccountName();
    $externalUserid = $entity->id();
    $user = \Drupal\user\Entity\User::load($entity->id());
    if(!$user->user_picture->isEmpty()){
      $avatarUrl = file_create_url($user->user_picture->entity->getFileUri());
    }else{
      $avatarUrl = '';
    }
    $email = $entity->getEmail();
    $userDetails = array("email" => $email,
            "avatarUrl" => $avatarUrl,
            "username" => $userName,
            "externalUserid" => $externalUserid,
            "name" => $userName);
            $url =  "/users/$userId";
    Drupal\website_toolbox_forum\sendApiRequest('POST',$url,$userDetails); 
    $syncOption = \Drupal::config('node.settings')->get('forum_roles_sync_option');
    if($syncOption == 1){
      $roles            = [];
      $removeUserGroups = [];
      $assignUserGroups = [];
      $roles = $entity->getRoles(TRUE); 
      $userGroupByName = Drupal\website_toolbox_forum\getUserGroupByName($getUserDetails); 
      if(!empty($roles)){
        $assignUserGroups = array_diff($roles, $userGroupByName);  
      } 
      if(!empty($userGroupByName)){
        $removeUserGroups = array_keys(array_diff($userGroupByName,$roles));
      }     
       Drupal\website_toolbox_forum\assignDivestUserGroup($email, $userName, $assignUserGroups,$removeUserGroups);
    }
}
function website_toolbox_forum_user_delete( Drupal\Core\Entity\EntityInterface $entity){
    $username     = $entity->getAccountName();
    $forumsApiKey = \Drupal::config('node.settings')->get('forum_api_key');
    $forumUrl     = \Drupal::config('node.settings')->get('forum_url'); 
    $URL          = $forumUrl . "/register";    
    $request = \Drupal::httpClient()->post($URL, [
        'verify' => true,
        'form_params' => ['type' => 'json',
        'apikey' => $forumsApiKey,
        'massaction' => 'decline_mem',
        'usernames' => $username,]               
        ])->getBody()->getContents();        
}
function website_toolbox_forum_page_bottom(array &$page_bottom) { 
    $userId = \Drupal::currentUser()->id();
    $forumUrl = \Drupal::config('node.settings')->get('forum_url');
    if ($userId == 0 && (isset($_COOKIE['forumLogoutToken']) || isset($_SESSION['forumLoginAuthToken']))) { 
        $logoutAuthUrl = $forumUrl . "/register/logout?authtoken=" . $_COOKIE['forumLogoutToken'];
        $logoutAuthUrl = preg_replace('#^https?:#i', '', $logoutAuthUrl);
        $page_bottom['contentImg'] = ['#markup' => '<img src="' . $logoutAuthUrl . '" border="0" width="0" height="0" alt="">'];
        Drupal\website_toolbox_forum\unsetLoginSession();
        Drupal\website_toolbox_forum\resetCookieOnLogout();
    }  
    if ($userId != 0 && (isset($_COOKIE['forumLogoutToken']) || isset($_SESSION['forumLoginAuthToken']))) { 
        $loginAuthUrl = $forumUrl . "/register/dologin?authtoken=" . $_COOKIE['forumLogoutToken'];
        $loginAuthUrl = preg_replace('#^https?:#i', '', $loginAuthUrl);
        $page_bottom['contentImg'] = ['#markup' => '<img src="' . $loginAuthUrl . '" border="0" width="0" height="0" alt="">'];
    }   
}
function existingUserForumLogin(){ 
    $userId = \Drupal::currentUser()->id();
    $email = \Drupal::currentUser()->getEmail();
    $username = \Drupal::currentUser()->getAccountName();
    $userData = (object) array(
        'name' => $username,
        'mail' => $email,
        'externalUserid' => $userId
    );   
    $getAuthDetails = Drupal\website_toolbox_forum\getForumAuthtoken($userData, "login");
    Drupal\website_toolbox_forum\setCookieOnLogin($getAuthDetails, "");
    Drupal\website_toolbox_forum\saveAuthToken($getAuthDetails['authtoken'], $getAuthDetails['forumUserid']);
}
function website_toolbox_forum_user_role_insert(EntityInterface $entity) { 
    $syncOption = \Drupal::config('node.settings')->get('forum_roles_sync_option');
    if($syncOption == 1){
      if ($entity->isSyncing()) {
        return;
      }
      $requestUrl = "/usergroups";
      $userGroupDetails = array("title"=>$entity->id(),"usertitle"=>$entity->label()); 
      Drupal\website_toolbox_forum\sendApiRequest('POST',$requestUrl,$userGroupDetails);
    }
}
function website_toolbox_forum_user_role_update(EntityInterface $entity) {
    $syncOption = \Drupal::config('node.settings')->get('forum_roles_sync_option');
    if($syncOption == 1){
      if ($entity->isSyncing()) {
        return;
      } 
      $userGroupId = Drupal\website_toolbox_forum\getUserGroupId($entity->id()); 
      if($userGroupId){
        $requestUrl = "/usergroups/".$userGroupId;
        $userGroupDetails = array("usertitle"=>$entity->label());
      }else{
        $requestUrl = "/usergroups";
        $userGroupDetails = array("title"=>$entity->id(),"usertitle"=>$entity->label());
      }
       
      Drupal\website_toolbox_forum\sendApiRequest('POST',$requestUrl,$userGroupDetails);
    }
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
function website_toolbox_forum_user_role_delete(EntityInterface $entity) {
    $syncOption = \Drupal::config('node.settings')->get('forum_roles_sync_option');
    if($syncOption == 1){
      if ($entity->isSyncing()) {
        return;
      } 
      $userGroupId = Drupal\website_toolbox_forum\getUserGroupId($entity->id()); 
      $requestUrl = "/usergroups/".$userGroupId;
      Drupal\website_toolbox_forum\sendApiRequest('DELETE',$requestUrl);
    }
}
