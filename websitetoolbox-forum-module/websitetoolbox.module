 /*create module admin configuration form*/
function websitetoolbox_admin() {
    $form = array();
    $form['websitetoolbox_forum_username'] = array(
      '#type' => 'textfield',
      '#title' => t('Website ToolBox Username'),
      '#default_value' => variable_get('websitetoolbox_forum_username', ""),
      '#size' => 60,
      '#maxlength' => 250,       
      '#required' => TRUE,
    );
    $form['websitetoolbox_forum_password'] = array(
      '#type' => 'password',
      '#title' => t('Website ToolBox Password'),
      '#default_value' => variable_get('websitetoolbox_forum_password', ""),
      '#size' => 60,
      '#maxlength' => 250,       
      '#required' => TRUE,
    );
    $form['websitetoolbox_forum_embedded'] = array(
      '#type' => 'checkbox',
      '#title' => t('Embedded'),
      '#default_value' => variable_get('websitetoolbox_forum_embedded', 1),
      '#size' => 60,
      '#maxlength' => 250,    
      '#required' => FALSE,
    );
     
    $form['#submit'][] = 'websitetoolbox_admin_submit';
     
    return system_settings_form($form);
}
 /*create module admin configuration form*/

/*submit username and password for forum configuation */
function websitetoolbox_admin_submit($form_id, &$form_state){ 
   
    $websitetoolbox_forum_username = $_REQUEST['websitetoolbox_forum_username'];
    $websitetoolbox_forum_password = $_REQUEST['websitetoolbox_forum_password'];
    $websitetoolbox_forum_embedded = $_REQUEST['websitetoolbox_forum_embedded'];
    if($websitetoolbox_forum_embedded == 1){
          $websitetoolbox_forum_embedded = 1;
    }else{
          $websitetoolbox_forum_embedded = 0;
    }
    websitetoolbox_plugin_chk($websitetoolbox_forum_username,$websitetoolbox_forum_password,$websitetoolbox_forum_embedded);
}

/*submit username and password for forum configuation */


/*get authtoken, save authtoken, create cookies after user logged in*/
function websitetoolbox_user_login (&$edit, $account) {
    global $user;
    checkSession();    
    $get_auth_details = websitetoolbox_authtoken($user,"login");
    setCookieOnLogin($get_auth_details, "");
    save_authToken($get_auth_details['authtoken'],$get_auth_details['access_token'],$get_auth_details['chatroom_url'],$get_auth_details['wtbUserid']);
}
/*get authtoken, save authtoken, create cookies after user logged in*/

/*Save authtoken in session*/
function save_authToken($authtoken,$access_token,$chatroom_url,$wtbUserid){
    checkSession();
    $_SESSION['wtb_login_auth_token'] = $authtoken;
    setWtbCookies('wtb_login_userid', $wtbUserid, 0);
    // Save access token into a session to login user on the caht room
    if($access_token) {
        $_SESSION['wtbchat_login_auth_token'] = $access_token;
        $_SESSION['wtbchat_url'] = $chatroom_url;
    }
}
/*Save authtoken in session*/

function websitetoolbox_authtoken ($user,$type) {
    if($type == 'login'){
        global $user;
    }
   $forum_api = variable_get('websitetoolbox_api'); 
   $forum_url = variable_get('websitetoolbox_url'); 
     if($forum_api) {
        $username = $user->name;
        $email = $user->mail;
        $URL = $forum_url."/register/setauthtoken";
 

        $data = array(
        'type' =>'json',
        'apikey' => $forum_api, 
        'user' => $username, 
        'email' => $email
        
        );
        $options = array(
            'type'=>'json',
            'method' => 'POST',
            'data' => drupal_http_build_query($data),
            'timeout' => 15,
            
        );
        $pass = $user->pass;
        if(isset($pass) && $pass != "") {
            $data['pw'] = $pass;
        }
        $result = drupal_http_request($URL, $options);
    
        //Check if http/https request could not return any error then filter JSON from response
        if($result) {
             
            $response = json_decode($result->data);
            if($response && $response->{'authtoken'} != "") {
                $authtoken = $response->{'authtoken'};
                $access_token = '';
                $chatroom_url = '';
                // Check if "-" exist in the authtoken then first part is authtoken (login on the forum) second part is access token login on Chat Room.
                if( strpos( $authtoken, "-" ) !== false ) {
                    $tokens = explode("-",$authtoken);
                    $authtoken = $tokens[0];
                    $access_token = $tokens[1];
                    $chatroom_url = $response->{'chatroom_url'};
                }
                $wtbUserid = $response->{'userid'};
                $responseArray = array(
                    'authtoken' => $authtoken,
                    'access_token' => $access_token,
                    'chatroom_url' => $chatroom_url,
                    'wtbUserid' => $wtbUserid
                );
                return $responseArray;
            }
        }
    }    
}


/* Purpose: Execute a HTTP request to validate forum login provided by the user.
Parameter: forum username, forum password.
Return: JSON responce */
function websitetoolbox_plugin_chk($websitetoolbox_forum_username,$websitetoolbox_forum_password,$websitetoolbox_forum_embedded) {
	$result = loginToForum($websitetoolbox_forum_username,$websitetoolbox_forum_password,$websitetoolbox_forum_embedded); 
	 
	if($result) { 
        $response =  json_decode($result->data);
        
        if($result->code != 200 || $response->{'errorMessage'}) {
            if($result->code == 403) {
              $ip = file_get_contents('https://api.ipify.org');
              $errorMessage = "Your IP address ($ip) is blocked. Please <a href='https://www.websitetoolbox.com/contact?subject=WordPress+IP($ip)+Blocked' target='_blank'>Contact Website Toolbox</a>.";
            } elseif ($result->code != 200) {
              $errorMessage = $response->{'errorMessage'};
            } else {
              #show error message to the user.
              $errorMessage = $response->{'errorMessage'};
              $errorMessage = preg_replace('#^Error:#', '', $errorMessage);
            }
            wtbForumSettingsPage($errorMessage);
            exit;
        } else { 
             $forum_address = $response->{'forumAddress'};
             $forumApliKey  = $response->{'forumApiKey'}; 
             if(variable_get('websitetoolbox_username') == ''){
             	variable_set('websitetoolbox_username',$websitetoolbox_forum_username ) ;
             }else{
             	 if(variable_get('websitetoolbox_username') != $websitetoolbox_forum_username){
             	 	variable_del('websitetoolbox_username');
             	 	variable_set('websitetoolbox_username',$websitetoolbox_forum_username ) ;
             	 }
             	
             }
             if(variable_get('websitetoolbox_api') == ''){
             	variable_set('websitetoolbox_api',$forumApliKey ) ;
             }else{
             	 if(variable_get('websitetoolbox_api') != $forumApliKey){
             	 	variable_del('websitetoolbox_api');
             	 	variable_set('websitetoolbox_api',$forumApliKey ) ;
             	 }
             	
             }
             if(variable_get('websitetoolbox_url') == ''){
             	variable_set('websitetoolbox_url',$forum_address ) ;
             }else{
             	 if(variable_get('websitetoolbox_url') != $forum_address){
             	 	variable_del('websitetoolbox_url');
             	 	variable_set('websitetoolbox_url',$forum_address) ;
             	 }
             	
             }
              
             
        }
    }
}  
function wtbForumSettingsPage($message = "") {
    if($message == 'username' || $message == 'password') {
        echo "<div id='wtb-warning' class='error'><p>Please enter forum $message.</p></div>";
    } else if($message && $message != 'success') {
        echo "<div id='wtb-warning' class='error'><p>$message</p></div>";
    }
    ?>
    
    <?php
}
/*check forum with username and password*/
function loginToForum($websitetoolbox_forum_username, $websitetoolbox_forum_password,$websitetoolbox_forum_embedded){
	$data = array(
  	'action'   => 'checkPluginLogin',
  	'username' => $websitetoolbox_forum_username,
  	'password' => $websitetoolbox_forum_password,

	);
 	$options = array(
		'type'=>'json',
		'method' => 'POST',
		'data' => drupal_http_build_query($data),
		'timeout' => 15,
		'headers' => array('Content-Type' => 'application/json'),
	);
  $result = drupal_http_request(MY_URL, $options);
  $response = json_decode($result->data); 
  $forum_url = $response->{'forumAddress'};
  $forum_address = $response->{'forumAddress'};
  $forumApliKey  = $response->{'forumApiKey'}; 
  $forum_username = $websitetoolbox_forum_username;
  $complete_forum_url =  $forum_url;
  
  if($websitetoolbox_forum_embedded == 1){
       #add embed code and set it as a link if "embed" option is disabled.
      updateForumData($forum_username,$forumApliKey,$base_url."/Forum");
      createEmbeddedForum($response,$websitetoolbox_forum_embedded);
    }else{
       #Remove embed code and set it as a link if "embed" option is disabled.
      updateForumData($forum_username,$forumApliKey);
      createMenuUrl($response);

  }
	return $result;
}
/*update forum data according to embedded enabled or disabled*/
function updateForumData($forumUsername,$forumAPI,$embedUrl=""){
      $data = array(   
        'action' => 'modifySSOURLs',
        'forumUsername' => $forumUsername,
        'forumApikey' => $forumAPI,
        'embed_page_url' => $embedUrl

    );
    $options = array(
        'type'=>'json',
        'method' => 'POST',
        'data' => drupal_http_build_query($data),
        'timeout' => 15,

    );
    $result = drupal_http_request(MY_URL, $options);
 }
 /*create url if embedded is disabled*/

function createMenuUrl($response){
  $forum_url = $response->{'forumAddress'};
   
  $complete_forum_url =  $forum_url;
  updateForumData($forum_username,$forumApliKey);
  $checkMenuExist = menu_get_item($complete_forum_url);
  $node_result = chkForumExist();
  $node = node_load(array_shift(array_keys($node_result['node'])));
  node_delete($node->nid);
  if(!$checkMenuExist){
      $menu = menu_load_links('main-menu'); 
      for($i=0;$i<count($menu);$i++){
        if($menu[$i]['link_title'] == 'Forum'){
            menu_link_delete(NULL,$menu[$i]['link_path']);
        }
      } 
      $item = array(
      'link_path' => $complete_forum_url,
      'link_title' => 'Forum',
      'menu_name' => 'navigation', // Menu machine name, for example: main-menu
      'weight' => 0,
      'language' => $node->language,
      'plid' => 0, // Parent menu item, 0 if menu item is on top level
      'module' => 'menu',
    );
    menu_link_save($item);
  } 
}
/*check if forumdata already exist*/
function chkForumExist(){
   $node_result = (new EntityFieldQuery())
  ->entityCondition('entity_type', 'node')
  ->propertyCondition('title', 'Forum')
  ->execute();
  return $node_result;
}
function createEmbeddedForum($response,$websitetoolbox_forum_embedded){
   $node_result = chkForumExist();
   $forum_url = $response->{'forumAddress'};   
   if(empty($node_result)){  
       global $user;       
       $node = (object) array('uid' => $user->uid, 'name' => (isset($user->name) ? $user->name : ''),'type' => 'page', 'language' => LANGUAGE_NONE, 'title' => 'Forum');
        node_save($node);
        $node_id = $node->nid;
        $vid = $node->vid;
    }else{ 
      $node = node_load(array_shift(array_keys($node_result['node'])));
      $node_id = $node->nid;
      $vid = $node->vid;
      $summary = $node->body['und'][0][summary];
    }
    if($summary == '' ){ 
        db_insert('field_data_body')
          ->fields(array(
            'entity_type' => 'node',
            'bundle'=>'page',
            'deleted' =>0,
            'entity_id' => $node_id,
           
            'delta'=>0,
            'revision_id'=>$vid,
            'language'=>'und',
            'delta' =>0,
            'body_value'=>'<div id="wtEmbedCode"><script type="text/javascript" id="embedded_forum" src="'.$forum_url.'/js/mb/embed.js"></script>
      <noscript><a href="'.$forum_url.'">Forum</a></noscript></div>',
            'body_summary'=>$forum_url,
            'body_format'=>'full_html',

          ))
          ->execute();
           
        db_insert('field_revision_body')
          ->fields(array(
            'entity_type' => 'node',
            'bundle'=>'page',
            'deleted' => 0,
            'entity_id' => $node_id,
            
            'delta'=>0,
            'revision_id'=>$vid,
            'language'=>'und',
            'delta' =>0,
            'body_value'=>'<div id="wtEmbedCode"><script type="text/javascript" id="embedded_forum" src="'.$forum_url.'"></script>
      <noscript><a href="'.$forum_url.'">Forum</a></noscript></div>',
            'body_summary'=>$forum_url,
            'body_format'=>'full_html',

          ))
          ->execute();
          $forum_url = menu_get_item($complete_forum_url);
          if(!$checkMenuExist){
            $menu = menu_load_links('main-menu'); 
            for($i=0;$i<count($menu);$i++){
              if($menu[$i]['link_title'] == 'Forum'){
                menu_link_delete(NULL,$menu[$i]['link_path']);
              }
          } 
             $menuUrl = 'node/'.$node_id;
             $item = array(
                'link_path' => $menuUrl,
                'link_title' => 'Forum',
                'menu_name' => 'main-menu', // Menu machine name, for example: main-menu
                'weight' => 0,
                'language' => $node->language,
                'plid' => 0, // Parent menu item, 0 if menu item is on top level
                'module' => 'menu',

            );
             menu_link_save($item);
          }
          
           
            db_insert('url_alias')
            ->fields(array(
              'source' => 'node/'.$node_id,
              'alias'=>'Forum',
              'language'=>'und',


            ))->execute();    
      }else{ 
        if($summary != $forum_url){  
             db_update('field_data_body')
          ->fields(array(
            'body_summary'=>$forum_url,
            'body_value'=>'<div id="wtEmbedCode"><script type="text/javascript" id="embedded_forum" src="'.$forum_url.'/js/mb/embed.js"></script>
      <noscript><a href="'.$forum_url.'">Forum</a></noscript></div>',
           

          ))  ->condition('entity_id', $node_id , '=')
          ->execute();
             db_update('field_revision_body')
             ->fields(array(
             'body_summary'=>$forum_url,
            'body_value'=>'<div id="wtEmbedCode"><script type="text/javascript" id="embedded_forum" src="'.$forum_url.'"></script>
      <noscript><a href="'.$forum_url.'">Forum</a></noscript></div>',
            

          ))->condition('entity_id', $node_id , '=')
          ->execute();
              
        }
      }
   
}

 /*register new user*/
function websitetoolbox_user_insert(){
 
  $username = $_REQUEST['name'];
  $email = $_REQUEST['mail'];
  $pass = $_REQUEST['pass'];
  
  $user_data = (object) array('name' => $username, 'mail' => $email, 'pass' => $pass);
	if (isset($_POST['pass1']) && $_POST['pass1'] != "") {
		$password = $_POST['pass1'];
	}else
	{
		$password = '';
	}
	
	// Fields array.
	$forum_api = variable_get('websitetoolbox_api');
	$forum_url = variable_get('websitetoolbox_url');
	$URL = $forum_url."/register/create_account/?";
	$data = array(	 
	'apikey' => $forum_api,
	'member' => $username,
	'email' => $email
	 
	);
	$options = array(
		'type'=>'json',
		'method' => 'POST',
		'data' => drupal_http_build_query($data),
		'timeout' => 15,
		 
	);
	$result = drupal_http_request($URL, $options);
  $get_auth_details = websitetoolbox_authtoken($user_data,"register");
  setCookieOnLogin($get_auth_details, "");
