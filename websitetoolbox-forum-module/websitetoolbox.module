<?php
global $base_url;
global $base_path;
include("websitetoolbox.include.inc");
DEFINE(MY_URL, 'https://www.websitetoolbox.com/tool/members/mb/settings');
DEFINE(API_URL, 'https://api.websitetoolbox.com/v1/api');
DEFINE(COOKIEPATH, $base_path);
DEFINE(COOKIE_DOMAIN, $base_url);

/* Print image tag on page render after logout and clear cookie and session*/
function WebsiteToolbox_page_alter(&$page)
{
  $page['#post_render'][] = 'printImageTagLogout';
}
function printImageTagLogout(&$data, $elements) {
  $wtbForumUrl = variable_get('wtb_forums_url');
  if(!user_is_logged_in() && (isset($_COOKIE['wtbLogoutToken'])||isset($_SESSION['wtbLoginAuthToken']))) {
    $logout_auth_url = $wtbForumUrl."/register/logout?authtoken=".$_COOKIE['wtbLogoutToken'];
    $logout_auth_url = preg_replace('#^https?:#i', '', $logout_auth_url);
    $img = '<img src="'.$logout_auth_url.'" border="0" width="0" height="0" alt="">';
    $data = preg_replace('@</body[^>]*>@', '$0' . $img, $data, 1);
    unsetLoginSession();
    resetCookieOnLogout();
  }else{
    $img = '';
    $data = preg_replace('@<body[^>]*>@', '$0' . $img, $data, 1);
  }
  return $data;
}

/*check if embedded is enable/disable in configuration*/
$chkIfEmbedded = variable_get('wtb_forum_embedded');

/*append forum link with authtoken after user logged in Case embedded disbale*/
if(user_is_logged_in() && $chkIfEmbedded != 1 ){
  function WebsiteToolbox_url_outbound_alter(&$path, &$options, $originalPath) {
    if($options['title'] == 'Forum'){
      if(isset($_COOKIE['wtbLogoutToken'])) {
        $cookie = $_COOKIE['wtbLogoutToken'];
      }elseif(isset($_SESSION['wtbLoginAuthToken'])){
        $cookie = $_SESSION['wtbLoginAuthToken'];
      }
      $alias = drupal_get_path_alias($original_path);
      $url = parse_url($alias);
      $options['query']['authtoken'] = $cookie;
    }
  }
}
/*render page if forum embedded enabled with authtoken append in forum embedded link*/
function WebsiteToolbox_node_view_alter(&$page) {
  $wtbForumsApiKey = variable_get('wtb_api_key');
  $wtbForumUrl = variable_get('wtb_forums_url');
  $content = $page['body']['#object']->body['und'][0]['value'];
  if(preg_match('#^https?://#', variable_get('wtb_forums_url'))) {
    $wtb_url = variable_get('wtb_forums_url');
  } else {
    $wtb_url = "http://".variable_get('wtb_forums_url');
  }
  $wtb_embed_url = preg_replace('#^https?:#i', '', $wtb_url);
  $auth_token = '';
  if(isset($_COOKIE['wtbLogoutToken'])) {
    $auth_token = "?authtoken=".$_COOKIE['wtbLogoutToken'];
  }elseif(isset($_SESSION['wtbLoginAuthToken'])){
        $auth_token = "?authtoken=".$_SESSION['wtbLoginAuthToken'];
      }
   if(isset($_COOKIE['wtbLogoutToken']) && isset($_COOKIE['wtbLoginRemember'])) {
    $auth_token .= "&remember=".$_COOKIE['wtbLoginRemember'];
  }
  $embedURL = $wtb_embed_url.'/js/mb/embed.js';
  $newURL =  $wtb_embed_url.'/js/mb/embed.js'.$auth_token;
  $content_changed = str_replace($embedURL,$newURL,$content);
  $page['body'][0]['#markup'] = $content_changed;
}
/** * Implements hook_menu for backend settings page().Create "configuration link for custom module" in administartor */
function WebsiteToolbox_menu() {
  $items = array();
  $items['admin/config/setting/websitetoolbox'] = array(
    'title' => t('Configuration of Website Toolbox Forum'),
    'description' => t('Configure the Website Toolbox module'),
    'page callback' => 'drupal_get_form',
    'page arguments' => array('adminConfigPageLayout'),
    'access arguments' => array('administer Website Toolbox Forum settings'),
    'file'            =>'websitetoolbox.admin.inc',
    'type' => MENU_NORMAL_ITEM, );
    return $items;
  }
/** * Implements hook_permission(). Implements hook_menu for backend settings page().Create "permission link for custom module in administartor" */
  function WebsiteToolbox_permission() {
    return array(
      'administer WebsiteToolbox settings' => array(
        'title' => t('Administer Website Toolbox configurations'),
        'restrict access' => true)
      );
    }
      function wtbGetAuthtoken ($user,$type) {
        if($type == 'login'){
          global $user;
        }
        $wtbForumsApiKey = variable_get('wtb_api_key');
        $wtbForumUrl = variable_get('wtb_forums_url');
        if($wtbForumsApiKey) {
          $username = $user->name;
          $email = $user->mail;
          $URL = $wtbForumUrl."/register/setauthtoken";
          $data = array(
            'type' =>'json',
            'apikey' => $wtbForumsApiKey,
            'user' => $username,
            'email' => $email

          );
          $options = array(
            'type'=>'json',
            'method' => 'POST',
            'data' => drupal_http_build_query($data),
            'timeout' => 15,

          );
          $pass = $user->pass;
          if(isset($pass) && $pass != "") {
            $data['pw'] = $pass;
          }
          $result = drupal_http_request($URL, $options);

          //Check if http/https request could not return any error then filter JSON from response
          if($result) {
            $response = json_decode($result->data);
            if($response && $response->{'authtoken'} != "") {
              $authtoken = $response->{'authtoken'};
              $access_token = '';

              // Check if "-" exist in the authtoken then first part is authtoken (login on the forum) second part is access token login on Chat Room.
              if( strpos( $authtoken, "-" ) !== false ) {
                $tokens = explode("-",$authtoken);
                $authtoken = $tokens[0];
                $access_token = $tokens[1];

              }
              $wtbUserid = $response->{'userid'};
              $responseArray = array(
                'authtoken' => $authtoken,


                'wtbUserid' => $wtbUserid
              );
              return $responseArray;
            }
          }
        }
      }

      function wtbForumSettingsPage($message = "") {
        if($message == 'username' || $message == 'password') {
          echo "<div id='wtb-warning' class='error'><p>Please enter forum $message.</p></div>";
        } else if($message && $message != 'success') {
          echo "<div id='wtb-warning' class='error'><p>$message</p></div>";
        }
      }
  /*register new user*/
  function WebsiteToolbox_user_insert(){
    $username = $_POST['name'];
    $email = $_POST['mail'];
    $pass = $_POST['pass'];
    $userData = (object) array('name' => $username, 'mail' => $email, 'pass' => $pass);
    if (isset($_POST['pass1']) && $_POST['pass1'] != "") {
      $password = $_POST['pass1'];
    }else
    {
      $password = '';
    }
    // Fields array.
    $wtbForumsApiKey = variable_get('wtb_api_key');
    $wtbForumUrl = variable_get('wtb_forums_url');
    $URL = $wtbForumUrl."/register/create_account/?";
    $data = array(
      'apikey' => $wtbForumsApiKey,
      'member' => $username,
      'email' => $email
    );
    $options = array(
      'type'=>'json',
      'method' => 'POST',
      'data' => drupal_http_build_query($data),
      'timeout' => 15,
    );

    $result = drupal_http_request($URL, $options);
    if(!$result){
      drupal_set_message($result->error);
      die();
    }
    checkSession();
    $getAuthDetails = wtbGetAuthtoken($userData,"register");
    setCookieOnLogin($getAuthDetails, "");
    saveAuthToken($getAuthDetails['authtoken'],$getAuthDetails['access_token'],$getAuthDetails['wtbUserid']);
  }
   function WebsiteToolbox_user_login (&$edit, $account) {
        global $user;
        checkSession();
        $getAuthDetails = wtbGetAuthtoken($user,"login");
        setCookieOnLogin($getAuthDetails, "");
        saveAuthToken($getAuthDetails['authtoken'],$getAuthDetails['access_token'],$getAuthDetails['wtbUserid']);
      }
      /*get authtoken, save authtoken, create cookies after user logged in*/

      /*Save authtoken in session*/
      function saveAuthToken($authtoken,$access_token,$wtbUserid){
        checkSession();
        $_SESSION['wtbLoginAuthToken'] = $authtoken;
        setWtbCookies('wtbLoginUserid', $wtbUserid, 0);
        // Save access token into a session to login user on the caht room

      }
  function WebsiteToolbox_user_delete($account) {
    $username = $account->name;
    $wtbForumsApiKey = variable_get('wtb_api_key');
    $wtbForumUrl = variable_get('wtb_forums_url');
    $URL = $wtbForumUrl."/register";
    $data = array(
      'apikey' => $wtbForumsApiKey,
      'massaction' => 'decline_mem',
      'usernames' =>  $username
    );
    $options = array(
      'type'=>'json',
      'method' => 'POST',
      'data' => drupal_http_build_query($data),
      'timeout' => 15,
    );

    $result = drupal_http_request($URL, $options);
    if(!$result){
      drupal_set_message($result->error);
      die();
    }
  }

  function WebsiteToolbox_user_update(&$edit, $account, $category){
    global $user;
    $wtbForumsApiKey = variable_get('wtb_api_key');
    $wtbForumUrl = variable_get('wtb_forums_url');
    $LoggedinUserid = $user->uid;
    $dProfileUserid = $edit['uid'];
    // change updated userid if admin update other user profile else get update userid from the cookie.
    // WTB logged-in userid store in the cookie when user logged-in on the WordPress website.
    if($LoggedinUserid != $wpProfileUserid) {
      $email =  $edit['mail'];
      $avatar =  $edit['picture'];
      $author = user_load($edit['uid']);
    }else{
      $email =  $user->mail;
      $avatar =  $user->picture;
      $author = user_load($account->uid);
    }
    $userId = getUserid($email);
    $author = user_load($account->uid);
    $avatar_url = file_create_url($author->picture->uri);
    // Update user data on the forum.
    if($userId) {
      $data =  array(
        "email"     => $email,
        "avatarUrl" => $avatar_url,
      );
      apiRequest('POST', "/users/$userId", $data);
    }
  }
  function getUserid($userEmail) {
    if($userEmail) {
      $data =  array(
        "email" => $userEmail,
      );
      $response = apiRequest('GET', "/users/", $data);
      if($response->{data}[0]->{userId}) {
        return $response->{data}[0]->{userId};
      }
    }
  }
  function apiRequest($method, $path, $data) {
    $url = API_URL.$path;
    if(strtoupper($method) == "GET") {
      $url = sprintf("%s?%s", $url, http_build_query($data));
    }
    $curl = curl_init();
    curl_setopt($curl, CURLOPT_URL, $url);
    curl_setopt($curl, CURLOPT_HTTPHEADER, array(
      "x-api-key: ".variable_get('wtb_api_key'),
      'Content-Type: application/json',
    ));
    curl_setopt($curl, CURLOPT_RETURNTRANSFER, 1);
    if(strtoupper($method) == "POST") {
      curl_setopt($curl, CURLOPT_POST, true);
      curl_setopt($curl, CURLOPT_POSTFIELDS, json_encode($data));
    } else if (strtoupper($method) == "GET") {
      curl_setopt($curl, CURLOPT_HTTPAUTH, CURLAUTH_BASIC);
    }
    $response = curl_exec($curl);
    curl_close($curl);
    return json_decode($response);
  }
  /* Purpose: remove paramete and it's value from the URL.
  Parameter: URL, parameter name
  Return: Updated URL */
  function removeParam($url, $param) {
    $url = preg_replace('/(&|\?)'.preg_quote($param).'=[^&]*$/', '', $url);
    $url = preg_replace('/(&|\?)'.preg_quote($param).'=[^&]*&/', '$1', $url);
    return $url;
  }