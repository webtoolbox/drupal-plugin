}

function websitetoolbox_user_delete($account) {
    $username = $account->name;
    $forum_api = variable_get('websitetoolbox_api');
    $forum_url = variable_get('websitetoolbox_url');
    $URL = $forum_url."/register";
    $data = array(   
        'apikey' => $forum_api,
        'massaction' => 'decline_mem',
        'usernames' =>  $username

    );

    $options = array(
        'type'=>'json',
        'method' => 'POST',
        'data' => drupal_http_build_query($data),
        'timeout' => 15,

    );
    $result = drupal_http_request($URL, $options);
    
}
 
function setCookieOnLogin($responseArray, $rememberme) { 
    $persistent = 0;
    if($rememberme != "") {
        setWtbCookies('wt_login_remember', "checked", $persistent);
        $persistent = 1;
    }
    // Save authentication token into cookie for one day to use into SSO logout.
    if(isset($responseArray['authtoken'])){ 
        setWtbCookies('wt_logout_token', $responseArray['authtoken'], $persistent);
    }
    // Save access token into cookie for one day to use into SSO logout from Chat Room.
    if(isset($responseArray['access_token'])) {
        setWtbCookies('wtchat_logout_token', $responseArray['access_token'], $persistent);
        setWtbCookies('wtchat_url', $responseArray['chatroom_url'], $persistent);
    }
    return true;
}
 
function checkSession(){
    if(!session_id()){
         drupal_session_start();
    } 
}

function setWtbCookies($cname, $cvalue, $persistent) {
  if($persistent == 1) {
    $expiration = (int) time() + (86400 * 365);
  } else {
    $expiration = 0;
  }
 

  setcookie($cname, $cvalue, $wtbBaseCookieOptions);
  // Pass param in setcookie function as a array if php version is 7.3 or above, to overcome the waring return on wordpress website.
  if(PHP_VERSION_ID < 70300) {
    if(isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] != 'off') {
      setcookie($cname, $cvalue, $expiration, COOKIEPATH." ; SameSite=None; Secure;", COOKIE_DOMAIN);
    } else {
      setcookie($cname, $cvalue, $expiration, COOKIEPATH, COOKIE_DOMAIN);
    }
  } else {
    $wtbBaseCookieOptions = [
      'expires' => $expiration,
      'path' => COOKIEPATH,
      'domain' => COOKIE_DOMAIN,
      'httponly' => true,
    ];
    if (isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] != 'off') {
      $wtbBaseCookieOptions['secure'] = true;
      $wtbBaseCookieOptions['samesite'] = 'None';
    }
    setcookie($cname, $cvalue, $wtbBaseCookieOptions);
  }  
}
 

function websitetoolbox_user_logout($account) {
    $forum_api = variable_get('websitetoolbox_api');
    $forum_url = variable_get('websitetoolbox_url');
    $logout_auth_url = $forum_url."/register/logout?authtoken=".$_COOKIE['wt_logout_token'];
    $logout_auth_url = preg_replace('#^https?:#i', '', $logout_auth_url);
    /* Print image tag on the header section sent logout request on the related forum */
    echo '<img src="'.$logout_auth_url.'" border="0" width="0" height="0" alt="">';
    /* If user logged-in on the chat room then logged-out from the chat room */
    if(isset($_COOKIE['wtchat_logout_token'])) {
      $chatlogout_auth_url = $_COOKIE['wtchat_url']."/sso/token/logout?access_token=".$_COOKIE['wtchat_logout_token'];
      echo '<img src="'.$chatlogout_auth_url.'" border="0" width="0" height="0" alt="">';
    }
    return false;
    if(!user_is_logged_in() && isset($_COOKIE['wt_logout_token'])) {
    $logout_auth_url = $forum_url."/register/logout?authtoken=".$_COOKIE['wt_logout_token'];
    $logout_auth_url = preg_replace('#^https?:#i', '', $logout_auth_url);
    /* Print image tag on the header section sent logout request on the related forum */
    echo '<img src="'.$logout_auth_url.'" border="0" width="0" height="0" alt="">';
    /* If user logged-in on the chat room then logged-out from the chat room */
    if(isset($_COOKIE['wtchat_logout_token'])) {
      $chatlogout_auth_url = $_COOKIE['wtchat_url']."/sso/token/logout?access_token=".$_COOKIE['wtchat_logout_token'];
      echo '<img src="'.$chatlogout_auth_url.'" border="0" width="0" height="0" alt="">';
    }

    resetCookieOnLogout();
    return false;
  }
   
}

function resetCookieOnLogout() {  
 
    unset($_COOKIE['wt_logout_token']);
     setcookie('wt_logout_token', 0, time() - 3600, $base_path);

    unset($_COOKIE['wtchat_logout_token']);
     setcookie('wtchat_logout_token', '', time() - 3600, $base_path);

    unset($_COOKIE['wtchat_url']);
     setcookie('wtchat_url', '', time() - 3600, $base_path);

    unset($_COOKIE['wtb_login_userid']);
     setcookie('wtb_login_userid', '', time() - 3600, $base_path);

    unset($_COOKIE['wt_login_remember']);
     setcookie('wt_login_remember', '', time() - 3600, $base_path);
  
  
}
function unsetLoginSession() {
    unset($_SESSION['wtb_login_auth_token']);
    unset($_SESSION['wtbchat_login_auth_token']);
    unset($_SESSION['wtbchat_url']);
}

function websitetoolbox_user_update(&$edit, $account, $category){

  global $user;
  
  $forum_api = variable_get('websitetoolbox_api');
  $forum_url = variable_get('websitetoolbox_url');

  $LoggedinUserid = $user->uid;
  $dProfileUserid = $edit['uid'];
  // change updated userid if admin update other user profile else get update userid from the cookie.
  // WTB logged-in userid store in the cookie when user logged-in on the WordPress website.
  if($LoggedinUserid != $wpProfileUserid) {
    $email =  $edit['mail'];
    $avatar =  $edit['picture'];
    $author = user_load($edit['uid']);
  }else{
    $email =  $user->mail;
    $avatar =  $user->picture;
    $author = user_load($account->uid);
   
  }
  $userId = getUserid($email);
   $author = user_load($account->uid);
 $avatar_url = file_create_url($author->picture->uri);
  // Update user data on the forum.
  if($userId) {
     
    $data =  array(
      "email"     => $email,        
      "avatarUrl" => $avatar_url,       
    );
 
    apiRequest('POST', "/users/$userId", $data);
        
  }
 
}
function getUserid($userEmail) {
  if($userEmail) {
    $data =  array(
      "email" => $userEmail,

    );
   
$response = apiRequest('GET', "/users/", $data);
    if($response->{data}[0]->{userId}) {
      return $response->{data}[0]->{userId};
    }
  }
}
function apiRequest($method, $path, $data) {
  $url = API_URL.$path;
  if(strtoupper($method) == "GET") {
    $url = sprintf("%s?%s", $url, http_build_query($data));
  }
  $curl = curl_init();
  curl_setopt($curl, CURLOPT_URL, $url);
  curl_setopt($curl, CURLOPT_HTTPHEADER, array(
    "x-api-key: ".variable_get('websitetoolbox_api'),
    'Content-Type: application/json',
  ));
  curl_setopt($curl, CURLOPT_RETURNTRANSFER, 1);
  if(strtoupper($method) == "POST") {
    curl_setopt($curl, CURLOPT_POST, true);
    curl_setopt($curl, CURLOPT_POSTFIELDS, json_encode($data));
  } else if (strtoupper($method) == "GET") {
    curl_setopt($curl, CURLOPT_HTTPAUTH, CURLAUTH_BASIC);
  }
  $response = curl_exec($curl);
 
  curl_close($curl);
  return json_decode($response);
}

/* Purpose: remove paramete and it's value from the URL.
Parameter: URL, parameter name
Return: Updated URL */
function removeParam($url, $param) {
    $url = preg_replace('/(&|\?)'.preg_quote($param).'=[^&]*$/', '', $url);
    $url = preg_replace('/(&|\?)'.preg_quote($param).'=[^&]*&/', '$1', $url);
    return $url;
}