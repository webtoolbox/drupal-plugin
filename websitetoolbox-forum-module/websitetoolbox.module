<?php   
global $base_url;
global $base_path;  

DEFINE(MY_URL, 'https://beta.websitetoolbox.com/tool/members/mb/settings');
DEFINE(API_URL, 'https://api.websitetoolbox.com/dev/api');
DEFINE(COOKIEPATH, $base_path);
DEFINE(COOKIE_DOMAIN, $base_url);

/* Print image on page render after logout*/
function websitetoolbox_page_alter(&$page)
{  
    $page['#post_render'][] = 'websitetoolbox_callback';
}
function websitetoolbox_callback(&$children, $elements) {
   $forum_url = variable_get('websitetoolbox_url'); 
   if(!user_is_logged_in() && isset($_COOKIE['wt_logout_token'])) {
        $logout_auth_url = $forum_url."/register/logout?authtoken=".$_COOKIE['wt_logout_token'];
        $logout_auth_url = preg_replace('#^https?:#i', '', $logout_auth_url);
        $img = '<img src="'.$logout_auth_url.'" border="0" width="0" height="0" alt="">';
        $children = preg_replace('@</body[^>]*>@', '$0' . $img, $children, 1);
     
        unsetLoginSession();
        resetCookieOnLogout(); 
   }else{
        $img = '';
        $children = preg_replace('@<body[^>]*>@', '$0' . $img, $children, 1);
  }
  return $children;
}
/* Print image on page render after logout*/

