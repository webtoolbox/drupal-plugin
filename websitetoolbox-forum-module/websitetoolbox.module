          $url = parse_url($alias);          
          $options['query']['authtoken'] = $cookie;
        }
    }
 } 

/*append forum link with authtoken after user logged in Case embedded disbale*/


/*render page if forum embedded enabled with authtoken append in forum embedded link*/
function bartik_node_view_alter(&$page) {
 
    $forum_api = variable_get('websitetoolbox_api');
    $forum_url = variable_get('websitetoolbox_url'); 
    $content = $page['body']['#object']->body['und'][0]['value'];
    if(preg_match('#^https?://#', variable_get('websitetoolbox_url'))) {
      $wtb_url = variable_get('websitetoolbox_url');
    } else {
      $wtb_url = "http://".variable_get('websitetoolbox_url');
    }
    $wtb_embed_url = preg_replace('#^https?:#i', '', $wtb_url);
    $auth_token = ''; 
    if(isset($_COOKIE['wt_logout_token'])) {
      $auth_token = "?authtoken=".$_COOKIE['wt_logout_token'];
    }

    if(isset($_COOKIE['wtchat_logout_token'])) {
        $auth_token .= "-".$_COOKIE['wtchat_logout_token'];
    }
    if(isset($_COOKIE['wt_logout_token']) && isset($_COOKIE['wt_login_remember'])) {
        $auth_token .= "&remember=".$_COOKIE['wt_login_remember'];
    }
    $embedURL = $wtb_embed_url.'/js/mb/embed.js';
    $newURL =  $wtb_embed_url.'/js/mb/embed.js'.$auth_token;
    $content_changed = str_replace($embedURL,$newURL,$content);    
    $page['body'][0]['#markup'] = $content_changed;
      
     
 }
/*render page if forum embedded enabled with authtoken append in forum embedded link*/

 
 
